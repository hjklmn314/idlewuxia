{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idlewuxia.runtime_persistence_contract.schema.v2",
  "type": "object",
  "required": [
    "$schema",
    "envelopeSchema",
    "legacyEnvelopeSchemas",
    "stateSchema",
    "schemaVersion",
    "minimumReadableVersion",
    "storageKey",
    "stagingStorageKey",
    "backupStorageKey",
    "rollbackStorageKey",
    "maxSavedEvents",
    "integrity",
    "migrations",
    "autosave",
    "transactionPolicy",
    "recoveryPolicy",
    "rollbackPolicy"
  ],
  "properties": {
    "$schema": { "const": "idlewuxia.runtime_persistence_contract.v2" },
    "envelopeSchema": { "const": "idlewuxia.runtime_save_envelope.v2" },
    "legacyEnvelopeSchemas": {
      "type": "object",
      "required": ["1"],
      "properties": { "1": { "const": "idlewuxia.runtime_save_envelope.v1" } },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "stateSchema": { "const": "idlewuxia.first_session_runtime_save.v1" },
    "schemaVersion": { "const": 2 },
    "minimumReadableVersion": { "type": "integer", "minimum": 1, "maximum": 2 },
    "storageKey": { "type": "string", "minLength": 1 },
    "stagingStorageKey": { "type": "string", "minLength": 1 },
    "backupStorageKey": { "type": "string", "minLength": 1 },
    "rollbackStorageKey": { "type": "string", "minLength": 1 },
    "maxSavedEvents": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "canonicalization"],
      "properties": {
        "algorithm": { "const": "fnv1a32" },
        "canonicalization": { "const": "recursive_object_key_sort_arrays_preserve_order" }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fromVersion", "toVersion", "mutation", "idempotencyKey"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "fromVersion": { "type": "integer", "minimum": 1 },
          "toVersion": { "type": "integer", "minimum": 2 },
          "mutation": { "type": "string", "minLength": 1 },
          "idempotencyKey": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "autosave": {
      "type": "object",
      "required": ["afterRuntimeMutation", "lifecycleEvents"],
      "properties": {
        "afterRuntimeMutation": { "const": true },
        "lifecycleEvents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["visibilitychange", "pagehide"] }
        }
      },
      "additionalProperties": false
    },
    "transactionPolicy": { "const": "staging_verify_backup_primary_verify_commit" },
    "recoveryPolicy": { "const": "current_then_staging_then_backup_fail_closed_on_future_or_incompatible" },
    "rollbackPolicy": { "const": "preserve_first_readable_legacy_envelope_until_explicit_clear" }
  },
  "additionalProperties": false
}
