{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schemas/browser_evidence_routes.v1.json",
  "type": "object",
  "required": ["$schema", "contractVersion", "runtimeScope", "hostPolicy", "routes"],
  "properties": {
    "$schema": {"const": "idlewuxia.browser_evidence_routes.v1"},
    "contractVersion": {"const": 1},
    "runtimeScope": {"const": "browser_evidence_only"},
    "hostPolicy": {
      "type": "object",
      "required": ["allowedHostnames", "requireFreshContext"],
      "properties": {
        "allowedHostnames": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "requireFreshContext": {"const": true}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["routeId", "purpose", "initialPlayerPatch", "steps", "expected"],
        "properties": {
          "routeId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "purpose": {"type": "string", "minLength": 1},
          "initialPlayerPatch": {
            "type": "object",
            "properties": {
              "sectId": {"type": "string", "minLength": 1},
              "inheritableMarkers": {"type": "object", "additionalProperties": {"anyOf": [{"type": "string"}, {"type": "number"}]}},
              "inventory": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
            },
            "additionalProperties": false
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"enum": ["dispatchAction", "selectNode", "selectRoom", "selectNpc", "interactNpc"]},
                "actionId": {"type": "string"},
                "nodeId": {"type": "string"},
                "roomId": {"type": "string"},
                "roleId": {"type": "string"},
                "actionType": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "expected": {
            "type": "object",
            "required": ["chapterId", "roomId", "roleId", "actionType"],
            "properties": {
              "chapterId": {"type": "string"},
              "roomId": {"type": "string"},
              "roleId": {"type": "string"},
              "actionType": {"type": "string"},
              "choiceId": {"type": "string"},
              "triggerResultId": {"type": "string"},
              "encounterId": {"type": "string"},
              "replacementChain": {"type": "array"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
