{
  "$schema": "idlewuxia.production.toolchain_registry.v1",
  "registryId": "idlewuxia-toolchain-v1",
  "tools": [
    {
      "id": "project-baseline",
      "command": "npm run baseline:verify",
      "artifact": "outputs/project_baseline",
      "stage": "G0",
      "status": "enabled",
      "notes": "Requires a real Git subprocess; restricted sandboxes can return a false zero-file result."
    },
    {
      "id": "production-contract-validation",
      "command": "npm run production:validate",
      "artifact": "outputs/production_os/validation-report.json",
      "stage": "G0",
      "status": "enabled"
    },
    {
      "id": "production-report-generation",
      "command": "npm run production:report",
      "artifact": "outputs/production_os/current-production-report.md",
      "stage": "G0",
      "status": "enabled"
    },
    {
      "id": "tracked-file-full-read-inventory",
      "command": "npm run production:inventory",
      "artifact": "outputs/production_os/tracked-file-full-read-inventory.json",
      "stage": "G2",
      "status": "enabled",
      "notes": "Reads every Git-tracked file to EOF, hashes it, counts full text and parses every tracked JSON document."
    },
    {
      "id": "workspace-hygiene-gate",
      "command": "npm run workspace:hygiene:audit",
      "artifact": "outputs/workspace_hygiene/hygiene_report.json",
      "stage": "G4",
      "status": "enabled",
      "taskId": "HYGIENE-001",
      "notes": "Classifies every tracked file, rejects active-to-legacy imports and protects the exact shipping closure with per-file SHA-256."
    },
    {
      "id": "runtime-fast-gate",
      "command": "npm run wuxia:check:fast",
      "artifact": "outputs/wuxia_p2_closure_gate",
      "stage": "G4",
      "status": "enabled"
    },
    {
      "id": "browser-flow",
      "command": "npm run wuxia:assert:dev-server",
      "artifact": "outputs/wuxia_browser_acceptance",
      "stage": "G5",
      "status": "partial"
    },
    {
      "id": "ui-acceptance-matrix-generator",
      "command": "npm run production:ui-matrix",
      "artifact": "outputs/production_os/ui-acceptance-matrix.json",
      "stage": "G5",
      "status": "enabled-planner",
      "notes": "Generates all 33 screen-viewport evidence obligations from the UI registry; it does not claim browser acceptance."
    },
    {
      "id": "browser-11x3-matrix",
      "command": "npm run wuxia:qa:ui-sweep",
      "artifact": "outputs/wuxia_visual_matrix",
      "stage": "G5",
      "status": "enabled",
      "taskId": "QA-UI-001",
      "notes": "Registry-driven real-browser sweep passes 30 active pairs; three UI_EarlyCombat pairs remain postponed by COMBAT-002."
    },
    {
      "id": "runtime-asset-registry-gate",
      "command": "npm run wuxia:validate:asset-registry",
      "artifact": "outputs/asset_registry_validation.json",
      "stage": "G5",
      "status": "enabled",
      "taskId": "T05-02",
      "notes": "Checks production-to-runtime projection parity, ownership, hashes, scope, formats and forbidden reference leakage."
    },
    {
      "id": "production-asset-contract-gate",
      "command": "npm run production:asset-contract",
      "artifact": "outputs/production_os/asset-contract-validation.json",
      "stage": "G5",
      "status": "enabled",
      "taskId": "ASSET-CONTRACT-001",
      "notes": "Validates source, ownership, hash, format, dimensions, pivot, budgets, animation clips, scene separation and runtime mount points. Strict mode remains blocked until all required slots have approved bytes."
    },
    {
      "id": "production-visual-standard-gate",
      "command": "npm run production:visual-standard",
      "artifact": "outputs/production_os/visual-standard-validation.json",
      "stage": "G5",
      "status": "enabled",
      "taskId": "VISUAL-STANDARD-001",
      "notes": "Validates portrait viewport thresholds and the side-view, three-head, no-baked-character, no-placeholder standard. It never substitutes for human visual acceptance."
    },
    {
      "id": "web-bundle-freshness",
      "command": "npm run web:freshness",
      "artifact": "outputs/web_bundle_freshness",
      "stage": "G7",
      "status": "enabled"
    },
    {
      "id": "chapter-authoring-inspection",
      "command": "npm run runtime:chapter-authoring:audit",
      "artifact": "outputs/editor_roi001/editor_roi_report.json",
      "stage": "G6",
      "status": "enabled-script-workflow",
      "taskId": "EDITOR-ROI-001",
      "notes": "Keeps JSON as the only content authority and adds headless schema/semantic validation, compact preview, semantic diff and hash-verified rollback evidence. A specialized visual editor remains deferred."
    },
    {
      "id": "security-release-contract-gate",
      "command": "npm run security:audit",
      "artifact": "outputs/security/sec001_security_audit.json",
      "stage": "G7",
      "status": "enabled",
      "taskId": "SEC-001",
      "notes": "Validates CSP, Android permissions/exported components/FileProvider scope, privacy retention, runtime dependency allowlist, external SDK absence and high-confidence secret patterns."
    },
    {
      "id": "android-debug-audit",
      "command": "npm run android:audit:wuxia",
      "artifact": "outputs/android_debug_audit",
      "stage": "G7",
      "status": "enabled-debug-only"
    },
    {
      "id": "signed-release-build",
      "command": "not-yet-implemented",
      "artifact": "outputs/release",
      "stage": "G7",
      "status": "blocked",
      "taskId": "REL-001"
    },
    {
      "id": "release-monitor-and-rollback",
      "command": "not-yet-implemented",
      "artifact": "outputs/release",
      "stage": "G7",
      "status": "blocked",
      "taskId": "REL-003"
    }
  ],
  "upstreamToolPolicy": {
    "baselineOnly": true,
    "allowedPatternAdoption": [
      "schema-validation",
      "artifact-registry",
      "browser-surface-sweep",
      "asset-budget",
      "release-gate-aggregation"
    ],
    "quarantinedBehaviors": [
      "permanent-delete",
      "safe-delete-outside-project-temp",
      "engine-adapter-placeholder-as-runtime-proof",
      "smoke-simulator-as-balance-proof"
    ]
  }
}
