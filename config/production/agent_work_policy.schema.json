{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/agent_work_policy.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "policyId", "version", "controllerRole", "independentAcceptanceRole", "manualAcceptanceOwner", "statuses", "gates", "handoffRequiredFields", "noCascadePolicy", "currentAssignments"],
  "properties": {
    "$schema": { "const": "idlewuxia.agent_work_policy.v1" },
    "policyId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "controllerRole": { "type": "string", "minLength": 1 },
    "independentAcceptanceRole": { "type": "string", "minLength": 1 },
    "manualAcceptanceOwner": { "type": "string", "minLength": 1 },
    "statuses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate1Engineering", "gate2StrictAcceptance", "finalManualAcceptance"],
      "properties": {
        "gate1Engineering": { "$ref": "#/$defs/gate" },
        "gate2StrictAcceptance": {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "type": "object",
              "required": ["requiresGate1"],
              "properties": { "requiresGate1": { "const": true } }
            }
          ]
        },
        "finalManualAcceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "owner", "requiresGate2", "required", "passRules", "failRules"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 },
            "requiresGate2": { "const": true },
            "required": { "$ref": "#/$defs/stringArray" },
            "passRules": { "$ref": "#/$defs/stringArray" },
            "failRules": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    },
    "handoffRequiredFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "noCascadePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredBeforeChange", "requiredAfterChange", "stopOn"],
      "properties": {
        "requiredBeforeChange": { "$ref": "#/$defs/stringArray" },
        "requiredAfterChange": { "$ref": "#/$defs/stringArray" },
        "stopOn": { "$ref": "#/$defs/stringArray" }
      }
    },
    "currentAssignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task", "owner", "acceptanceOwner", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "acceptanceOwner": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "required", "passRules", "failRules"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "requiresGate1": { "type": "boolean" },
        "required": { "$ref": "#/$defs/stringArray" },
        "passRules": { "$ref": "#/$defs/stringArray" },
        "failRules": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
