{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/production/visual-standard-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "standardId", "version", "style", "portrait", "combat", "manualReview"],
  "properties": {
    "$schema": { "const": "idlewuxia.production.visual_standard.v2" },
    "standardId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "const": 2 },
    "style": { "$ref": "#/$defs/style" },
    "portrait": { "$ref": "#/$defs/portrait" },
    "combat": { "$ref": "#/$defs/combat" },
    "manualReview": { "$ref": "#/$defs/manualReview" }
  },
  "$defs": {
    "range": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "number", "exclusiveMinimum": 0 }, "max": { "type": "number", "exclusiveMinimum": 0 } } },
    "dimensions": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 16 }, "height": { "type": "integer", "minimum": 16 } } },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["rendering", "characterView", "canonicalFacing", "opposingSideTransform", "forbiddenCharacterViews", "characterConstruction", "requiredCharacterParts", "optionalCharacterParts", "bodyPartIncludes", "legSilhouette", "headToBodyHeightRatio", "logicalCanvasPx", "sceneContainsBakedCharacters", "sceneAndActorLayersSeparated", "antiAliasing", "integerScale", "palettePolicy"],
      "properties": {
        "rendering": { "const": "nearest-neighbor-pixel" },
        "characterView": { "const": "side" },
        "canonicalFacing": { "const": "right" },
        "opposingSideTransform": { "const": "horizontal-mirror" },
        "forbiddenCharacterViews": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string" } },
        "characterConstruction": { "const": "modular-head-body" },
        "requiredCharacterParts": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["body", "head-base", "eyes", "mouth", "hair"] } },
        "optionalCharacterParts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "bodyPartIncludes": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
        "legSilhouette": { "const": "forbidden" },
        "headToBodyHeightRatio": { "$ref": "#/$defs/range" },
        "logicalCanvasPx": { "$ref": "#/$defs/dimensions" },
        "sceneContainsBakedCharacters": { "const": false },
        "sceneAndActorLayersSeparated": { "const": true },
        "antiAliasing": { "const": "forbidden" },
        "integerScale": { "const": true },
        "palettePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "portrait": {
      "type": "object", "additionalProperties": false,
      "required": ["orientation", "referenceAspectRatio", "aspectRatioTolerance", "viewports", "touchTargetMinDp", "bodyTextMinPx", "titleTextMinPx", "feedbackVisibilityMs"],
      "properties": {
        "orientation": { "const": "portrait" },
        "referenceAspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "aspectRatioTolerance": { "type": "number", "minimum": 0 },
        "viewports": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["id", "width", "height", "safeAreaDp"], "properties": { "id": { "type": "string", "minLength": 1 }, "width": { "type": "integer", "minimum": 320 }, "height": { "type": "integer", "minimum": 568 }, "safeAreaDp": { "type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": { "top": { "type": "number", "minimum": 0 }, "right": { "type": "number", "minimum": 0 }, "bottom": { "type": "number", "minimum": 0 }, "left": { "type": "number", "minimum": 0 } } } } } },
        "touchTargetMinDp": { "const": 44 },
        "bodyTextMinPx": { "type": "number", "minimum": 14 },
        "titleTextMinPx": { "type": "number", "minimum": 18 },
        "feedbackVisibilityMs": { "type": "integer", "minimum": 500 }
      }
    },
    "combat": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredActorStates", "movementPhasePolicy", "forbiddenMovementSignals", "layerAnimationPolicy", "actorAndFeedbackOcclusion", "minimumFeedbackContrastRatio", "maximumAudioFeedbackLatencyMs", "placeholderPresentation", "requiredFeedbackTypes"],
      "properties": {
        "requiredActorStates": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "movementPhasePolicy": { "const": "body-compress-translate-recover" },
        "forbiddenMovementSignals": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
        "layerAnimationPolicy": { "const": "shared-frame-timeline-and-anchor-set" },
        "actorAndFeedbackOcclusion": { "const": "forbidden" },
        "minimumFeedbackContrastRatio": { "type": "number", "minimum": 4.5 },
        "maximumAudioFeedbackLatencyMs": { "type": "integer", "maximum": 120, "minimum": 1 },
        "placeholderPresentation": { "const": "forbidden" },
        "requiredFeedbackTypes": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "manualReview": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredEvidence", "allowedVerdicts", "rejectReasons"],
      "properties": {
        "requiredEvidence": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
        "allowedVerdicts": { "const": ["PASS", "FAIL"] },
        "rejectReasons": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
