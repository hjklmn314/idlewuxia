{
  "$schema": "idlewuxia.production.visual_standard.v2",
  "standardId": "idlewuxia-portrait-wuxia-modular-pixel-v2",
  "version": 2,
  "style": {
    "rendering": "nearest-neighbor-pixel",
    "characterView": "side",
    "canonicalFacing": "right",
    "opposingSideTransform": "horizontal-mirror",
    "forbiddenCharacterViews": ["front", "back", "three-quarter", "isometric"],
    "characterConstruction": "modular-head-body",
    "requiredCharacterParts": ["body", "head-base", "eyes", "mouth", "hair"],
    "optionalCharacterParts": ["headwear", "face-accessory", "weapon-rear", "weapon-front", "contact-shadow"],
    "bodyPartIncludes": ["torso", "sleeves", "integrated-hands"],
    "legSilhouette": "forbidden",
    "headToBodyHeightRatio": { "min": 0.75, "max": 1.15 },
    "logicalCanvasPx": { "width": 96, "height": 96 },
    "sceneContainsBakedCharacters": false,
    "sceneAndActorLayersSeparated": true,
    "antiAliasing": "forbidden",
    "integerScale": true,
    "palettePolicy": "bounded-wuxia-palette"
  },
  "portrait": {
    "orientation": "portrait",
    "referenceAspectRatio": 0.45,
    "aspectRatioTolerance": 0.04,
    "viewports": [
      { "id": "android-compact", "width": 360, "height": 800, "safeAreaDp": { "top": 16, "right": 16, "bottom": 16, "left": 16 } },
      { "id": "android-baseline", "width": 390, "height": 844, "safeAreaDp": { "top": 16, "right": 16, "bottom": 16, "left": 16 } },
      { "id": "android-tall", "width": 412, "height": 915, "safeAreaDp": { "top": 16, "right": 16, "bottom": 16, "left": 16 } }
    ],
    "touchTargetMinDp": 44,
    "bodyTextMinPx": 14,
    "titleTextMinPx": 18,
    "feedbackVisibilityMs": 900
  },
  "combat": {
    "requiredActorStates": ["idle", "move", "attack", "hurt", "control", "defeat"],
    "movementPhasePolicy": "body-compress-translate-recover",
    "forbiddenMovementSignals": ["left-foot-forward", "right-foot-forward", "independent-leg-cycle"],
    "layerAnimationPolicy": "shared-frame-timeline-and-anchor-set",
    "actorAndFeedbackOcclusion": "forbidden",
    "minimumFeedbackContrastRatio": 4.5,
    "maximumAudioFeedbackLatencyMs": 120,
    "placeholderPresentation": "forbidden",
    "requiredFeedbackTypes": ["damage", "miss", "block", "heal", "buff", "debuff", "control", "defeat", "victory"]
  },
  "manualReview": {
    "requiredEvidence": ["screenshot", "viewport", "state", "layer-set", "reviewer", "verdict", "notes"],
    "allowedVerdicts": ["PASS", "FAIL"],
    "rejectReasons": [
      "wrong-character-view",
      "wrong-head-body-construction",
      "visible-leg-silhouette",
      "required-character-part-not-separated",
      "layer-anchor-drift",
      "baked-character-in-scene",
      "non-pixel-filtering",
      "missing-animation-frame",
      "movement-does-not-use-body-phase-cycle",
      "actor-or-feedback-occluded",
      "touch-target-too-small",
      "text-unreadable",
      "placeholder-presentation",
      "audio-missing-or-late"
    ]
  }
}
