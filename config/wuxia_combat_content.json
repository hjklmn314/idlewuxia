  "rules": {
    "maxRounds": 40,
    "maxEvents": 512,
    "turnOrder": "speed_then_seeded_tiebreak",
    "roundStartEffects": true,
    "roundEndEffects": true,
    "defaultActionId": "skill_basic_strike",
    "defaultAiPolicyId": "ai_balanced",
    "defaultEncounterId": "encounter_first_session_old_steward",
    "attributeDefaults": {
      "vitality": 0,
      "spirit": 0,
      "strength": 0,
      "constitution": 0,
      "speed": 0,
      "skillPower": 0,
      "armor": 0,
      "luck": 0,
      "critRating": 0,
      "evasionRating": 0,
      "accuracy": 1,
      "tenacity": 0,
      "physicalResistance": 0,
      "internalResistance": 0,
      "fireResistance": 0,
      "iceResistance": 0,
      "poisonResistance": 0,
      "blockChance": 0,
      "blockPower": 0,
      "haste": 0,
      "penetration": 0,
      "defensePenetration": 0,
      "lifesteal": 0,
      "damageTakenMultiplier": 1
