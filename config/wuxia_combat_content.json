    "damage": {
      "minimumDamage": 1,
      "criticalMultiplier": 1.5,
      "blockMultiplier": 0.55,
      "glancingMultiplier": 0.75,
      "glanceChance": 0.15,
      "resistanceFloor": -0.75,
      "resistanceCeiling": 0.9,
      "rules": {
        "physical": { "defenseAttribute": "defensePower", "defenseConstant": 100, "usesResistance": true, "resistanceKey": "physicalResistance", "canCrit": true, "canBlock": true, "canGlance": true },
        "internal": { "defenseAttribute": "internalDefense", "defenseConstant": 100, "usesResistance": true, "resistanceKey": "internalResistance", "canCrit": true, "canBlock": false, "canGlance": false },
        "fire": { "defenseAttribute": "elementalDefense", "defenseConstant": 100, "usesResistance": true, "resistanceKey": "fireResistance", "canCrit": true, "canBlock": false, "canGlance": true },
        "ice": { "defenseAttribute": "elementalDefense", "defenseConstant": 100, "usesResistance": true, "resistanceKey": "iceResistance", "canCrit": true, "canBlock": false, "canGlance": true },
        "poison": { "defenseAttribute": "poisonDefense", "defenseConstant": 100, "usesResistance": true, "resistanceKey": "poisonResistance", "canCrit": false, "canBlock": false, "canGlance": false },
        "true": { "defenseAttribute": "", "defenseConstant": 0, "usesResistance": false, "resistanceKey": "", "canCrit": false, "canBlock": false, "canGlance": false }
      },
      "defaultRule": { "defenseAttribute": "defensePower", "defenseConstant": 100, "usesResistance": true, "resistanceKey": "physicalResistance", "canCrit": true, "canBlock": true, "canGlance": true }
    },
    "attributes": {
      "maxHp": { "op": "add", "args": [{ "op": "mul", "args": [{ "ref": "vitality" }, { "const": 12 }] }, { "ref": "level" }] },
      "maxMp": { "op": "add", "args": [{ "op": "mul", "args": [{ "ref": "spirit" }, { "const": 4 }] }, { "ref": "level" }] },
      "attackPower": { "op": "add", "args": [{ "ref": "strength" }, { "op": "mul", "args": [{ "ref": "skillPower" }, { "const": 0.65 }] }] },
      "defensePower": { "op": "add", "args": [{ "ref": "constitution" }, { "op": "mul", "args": [{ "ref": "armor" }, { "const": 0.75 }] }] },
      "internalDefense": { "op": "add", "args": [{ "ref": "spirit" }, { "op": "mul", "args": [{ "ref": "constitution" }, { "const": 0.5 }] }] },
      "elementalDefense": { "op": "add", "args": [{ "op": "mul", "args": [{ "ref": "spirit" }, { "const": 0.4 }] }, { "op": "mul", "args": [{ "ref": "armor" }, { "const": 0.25 }] }] },
      "poisonDefense": { "op": "add", "args": [{ "op": "mul", "args": [{ "ref": "vitality" }, { "const": 0.2 }] }, { "op": "mul", "args": [{ "ref": "constitution" }, { "const": 0.2 }] }] },
      "initiative": { "op": "add", "args": [{ "ref": "speed" }, { "ref": "haste" }] },
      "critChance": { "op": "clamp", "args": [{ "op": "add", "args": [{ "ref": "critRating" }, { "op": "mul", "args": [{ "ref": "luck" }, { "const": 0.01 }] }] }, { "const": 0 }, { "const": 1 }] },
      "evasionChance": { "op": "clamp", "args": [{ "op": "add", "args": [{ "ref": "evasionRating" }, { "op": "mul", "args": [{ "ref": "speed" }, { "const": 0.002 }] }] }, { "const": 0 }, { "const": 0.8 }] }
    },
    "damageTypes": ["physical", "internal", "fire", "ice", "poison", "true"],
    "effectOrder": ["damage", "heal", "shield", "applyBuff", "removeBuff", "resource", "statModifier"],
    "buffRules": {
      "maxStacks": 5,
      "durationUnit": "turns",
      "stackPolicies": ["stack", "refresh", "replace", "unique"],
      "dispelTags": ["positive", "negative", "control", "damageOverTime"]
