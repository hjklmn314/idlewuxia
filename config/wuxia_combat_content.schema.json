{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idlewuxia.combat_content.v1",
  "type": "object",
  "required": ["$schema", "schemaVersion", "version", "rules", "factions", "units", "skills", "buffs", "encounters", "visualCues", "audioCues"],
  "properties": {
    "$schema": { "const": "idlewuxia.combat_content.v1" },
    "schemaVersion": { "const": "idlewuxia.combat_content.v1" },
    "version": { "type": "integer", "minimum": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "object",
      "required": ["maxRounds", "maxEvents", "defaultActionId", "defaultAiPolicyId", "damage", "attributes", "damageTypes", "buffRules", "presentation"],
      "properties": {
        "maxRounds": { "type": "integer", "minimum": 1 },
        "maxEvents": { "type": "integer", "minimum": 32 },
        "defaultActionId": { "type": "string", "minLength": 1 },
        "defaultAiPolicyId": { "type": "string", "minLength": 1 },
        "damageTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "attributes": { "type": "object", "minProperties": 1 },
        "damage": { "type": "object", "required": ["minimumDamage", "criticalMultiplier", "blockMultiplier", "resistanceFloor", "resistanceCeiling", "rules", "defaultRule"], "properties": { "minimumDamage": { "type": "number", "minimum": 0 }, "criticalMultiplier": { "type": "number", "minimum": 0 }, "blockMultiplier": { "type": "number", "minimum": 0 }, "resistanceFloor": { "type": "number" }, "resistanceCeiling": { "type": "number" }, "rules": { "type": "object", "minProperties": 1 }, "defaultRule": { "type": "object", "required": ["defenseConstant", "canCrit", "canBlock", "canGlance"] } }, "additionalProperties": true },
        "buffRules": { "type": "object", "required": ["maxStacks", "durationUnit", "stackPolicies"] },
        "presentation": { "type": "object", "required": ["turnDurationMs", "floatingTextLifetimeMs"] }
      },
      "additionalProperties": true
    },
    "factions": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["factionId", "hostileTo"], "properties": { "factionId": { "type": "string", "minLength": 1 }, "hostileTo": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true } },
    "units": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["unitId", "factionId", "attributes", "skillIds"], "properties": { "unitId": { "type": "string", "minLength": 1 }, "factionId": { "type": "string", "minLength": 1 }, "attributes": { "type": "object" }, "skillIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true } },
    "skills": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["skillId", "kind", "target", "effects"], "properties": { "skillId": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 }, "effects": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string", "minLength": 1 } }, "additionalProperties": true } } }, "additionalProperties": true } },
    "buffs": { "type": "array", "items": { "type": "object", "required": ["buffId", "tags", "duration"], "properties": { "buffId": { "type": "string", "minLength": 1 }, "tags": { "type": "array", "items": { "type": "string" } }, "duration": { "type": "integer", "minimum": 1 } }, "additionalProperties": true } },
    "encounters": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["encounterId", "playerUnitIds", "enemyUnitIds"], "properties": { "encounterId": { "type": "string", "minLength": 1 }, "playerUnitIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "enemyUnitIds": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": true } },
    "visualCues": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["cueId", "eventType"], "properties": { "cueId": { "type": "string", "minLength": 1 }, "eventType": { "type": "string", "minLength": 1 } }, "additionalProperties": true } },
    "audioCues": { "type": "array", "items": { "type": "object", "required": ["audioCueId"], "properties": { "audioCueId": { "type": "string", "minLength": 1 } }, "additionalProperties": true } },
    "assetBindings": { "type": "object" }
  },
  "additionalProperties": true
}
