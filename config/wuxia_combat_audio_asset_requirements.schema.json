{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/wuxia_combat_audio_asset_requirements.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractId", "version", "taskId", "mode", "shippingAllowed", "sourcePolicy", "policy", "referenceAudit", "audioCues", "acceptanceGate"],
  "properties": {
    "$schema": { "const": "idlewuxia.combat_audio_asset_requirements.v1" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "const": 1 },
    "taskId": { "const": "ASSET-010" },
    "mode": { "const": "reference-backed-requirements" },
    "shippingAllowed": { "const": false },
    "sourcePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceMayInformRequirements", "referenceBytesMayShip", "referenceBindingsMaySatisfyProduction", "runtimeUsesLogicalIdsOnly"],
      "properties": {
        "referenceMayInformRequirements": { "const": true },
        "referenceBytesMayShip": { "const": false },
        "referenceBindingsMaySatisfyProduction": { "const": false },
        "runtimeUsesLogicalIdsOnly": { "const": true }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["audioCueCount", "productionFormat", "productionRejectsSynth", "productionRejectsOscillator", "productionRejectsReferenceOnly", "maxTriggerLatencyMs", "targetLufsIntegrated", "peakCeilingDbtp", "manualMixReviewRequired", "manualDeviceReviewRequired", "runtimeMountPoint", "logicalIdOnly", "fallbackScope"],
      "properties": {
        "audioCueCount": { "const": 5 },
        "productionFormat": { "const": "ogg" },
        "productionRejectsSynth": { "const": true },
        "productionRejectsOscillator": { "const": true },
        "productionRejectsReferenceOnly": { "const": true },
        "maxTriggerLatencyMs": { "const": 120 },
        "targetLufsIntegrated": { "const": -16 },
        "peakCeilingDbtp": { "const": -1 },
        "manualMixReviewRequired": { "const": true },
        "manualDeviceReviewRequired": { "const": true },
        "runtimeMountPoint": { "const": "combat.audio" },
        "logicalIdOnly": { "const": true },
        "fallbackScope": { "const": "development-only" }
      }
    },
    "referenceAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceRootId", "referenceRoot", "inventory", "productionEligibleCandidates", "auditedReferenceCandidates", "conclusion", "auditedAt", "auditor"],
      "properties": {
        "referenceRootId": { "type": "string", "minLength": 1 },
        "referenceRoot": { "type": "string", "minLength": 1 },
        "inventory": {
          "type": "object", "additionalProperties": false,
          "required": ["fightMp3Candidates", "musicMp3Candidates", "auditedReferenceCandidates", "inventoryBasis"],
          "properties": {
            "fightMp3Candidates": { "const": 118 },
            "musicMp3Candidates": { "const": 410 },
            "auditedReferenceCandidates": { "const": 4 },
            "inventoryBasis": { "type": "string", "minLength": 1 }
          }
        },
        "productionEligibleCandidates": { "type": "array", "maxItems": 0, "items": { "type": "object" } },
        "auditedReferenceCandidates": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/candidate" } },
        "conclusion": { "type": "string", "minLength": 1 },
        "auditedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "auditor": { "type": "string", "minLength": 1 }
      }
    },
    "audioCues": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/audioCue" } },
    "acceptanceGate": { "$ref": "#/$defs/gate" }
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceAssetId", "relativePath", "format", "bytes", "sha256", "manualObservation", "disposition"],
      "properties": {
        "referenceAssetId": { "type": "string", "pattern": "^ref-audio-[a-z0-9-]+$" },
        "relativePath": { "type": "string", "minLength": 1 },
        "format": { "const": "mp3" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manualObservation": { "type": "string", "minLength": 1 },
        "disposition": { "const": "reference-only" }
      }
    },
    "audioCue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "logicalAssetId", "eventType", "requiredPresentation", "status", "referenceAssetId"],
      "properties": {
        "id": { "type": "string", "pattern": "^sfx_[a-z0-9_]+$" },
        "logicalAssetId": { "type": "string", "pattern": "^combat-audio-[a-z0-9-]+$" },
        "eventType": { "type": "string", "minLength": 1 },
        "requiredPresentation": { "type": "string", "minLength": 1 },
        "status": { "const": "reference-only" },
        "referenceAssetId": { "type": "string", "pattern": "^ref-audio-[a-z0-9-]+$" }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["productionStatus", "requiredEvidence", "nextAction"],
      "properties": {
        "productionStatus": { "const": "blocked" },
        "requiredEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "nextAction": { "type": "string", "minLength": 1 }
      }
    }
  }
}
