{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/wuxia_combat_actor_asset_requirements.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractId", "version", "taskId", "mode", "shippingAllowed", "sourcePolicy", "policy", "referenceAudit", "partCatalogRequirements", "actors", "acceptanceGate"],
  "properties": {
    "$schema": { "const": "idlewuxia.combat_actor_asset_requirements.v2" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "const": 2 },
    "taskId": { "const": "ASSET-007" },
    "mode": { "const": "requirements-only" },
    "shippingAllowed": { "const": false },
    "sourcePolicy": { "$ref": "#/$defs/sourcePolicy" },
    "policy": { "$ref": "#/$defs/policy" },
    "referenceAudit": { "$ref": "#/$defs/referenceAudit" },
    "partCatalogRequirements": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/partCatalog" } },
    "actors": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/actor" } },
    "acceptanceGate": { "$ref": "#/$defs/acceptanceGate" }
  },
  "$defs": {
    "range": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "number", "exclusiveMinimum": 0 }, "max": { "type": "number", "exclusiveMinimum": 0 } } },
    "dimensions": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 96 }, "height": { "const": 96 } } },
    "sourcePolicy": { "type": "object", "additionalProperties": false, "required": ["referenceMayInformRequirements", "referenceBytesMayShip", "referenceBindingsMaySatisfyProduction", "runtimeUsesLogicalIdsOnly"], "properties": { "referenceMayInformRequirements": { "const": true }, "referenceBytesMayShip": { "const": false }, "referenceBindingsMaySatisfyProduction": { "const": false }, "runtimeUsesLogicalIdsOnly": { "const": true } } },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["view", "canonicalFacing", "opposingSideTransform", "construction", "requiredParts", "optionalParts", "layerOrderBackToFront", "bodyPartIncludes", "legSilhouette", "headToBodyHeightRatio", "logicalCanvasPx", "requiredAnchors", "requiredClips", "movementPhasePolicy", "noBakedScenePixels", "integerScaleOnly", "transparentBackgroundRequired", "manualFrameReviewRequired", "portraitSafeAreaRequired"],
      "properties": {
        "view": { "const": "side" }, "canonicalFacing": { "const": "right" }, "opposingSideTransform": { "const": "horizontal-mirror" }, "construction": { "const": "modular-head-body" },
        "requiredParts": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["body", "head-base", "eyes", "mouth", "hair"] } },
        "optionalParts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "layerOrderBackToFront": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "bodyPartIncludes": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
        "legSilhouette": { "const": "forbidden" }, "headToBodyHeightRatio": { "$ref": "#/$defs/range" }, "logicalCanvasPx": { "$ref": "#/$defs/dimensions" },
        "requiredAnchors": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "requiredClips": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "movementPhasePolicy": { "const": "body-compress-translate-recover" }, "noBakedScenePixels": { "const": true }, "integerScaleOnly": { "const": true }, "transparentBackgroundRequired": { "const": true }, "manualFrameReviewRequired": { "const": true }, "portraitSafeAreaRequired": { "const": true }
      }
    },
    "inventory": { "type": "object", "additionalProperties": false, "required": ["png", "jpg", "mp3", "lua", "txt", "totalFiles", "inventoryBasis"], "properties": { "png": { "type": "integer", "minimum": 0 }, "jpg": { "type": "integer", "minimum": 0 }, "mp3": { "type": "integer", "minimum": 0 }, "lua": { "type": "integer", "minimum": 0 }, "txt": { "type": "integer", "minimum": 0 }, "totalFiles": { "type": "integer", "minimum": 1 }, "inventoryBasis": { "type": "string", "minLength": 1 } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["relativePath", "kind", "observed", "disposition", "reason"], "properties": { "relativePath": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }, "observed": { "type": "string", "minLength": 1 }, "disposition": { "const": "ineligible" }, "reason": { "type": "string", "minLength": 1 } } },
    "referenceAudit": { "type": "object", "additionalProperties": false, "required": ["referenceRootId", "referenceRoot", "inventory", "eligibleCandidates", "ineligibleEvidence", "conclusion", "auditedAt", "auditor"], "properties": { "referenceRootId": { "type": "string", "minLength": 1 }, "referenceRoot": { "type": "string", "minLength": 1 }, "inventory": { "$ref": "#/$defs/inventory" }, "eligibleCandidates": { "type": "array", "maxItems": 0, "items": { "type": "object" } }, "ineligibleEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }, "conclusion": { "type": "string", "minLength": 1 }, "auditedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "auditor": { "type": "string", "minLength": 1 } } },
    "partCatalog": { "type": "object", "additionalProperties": false, "required": ["partType", "minimumVariants", "requiredExpressions", "paletteChannels", "runtimeMountPoint"], "properties": { "partType": { "enum": ["body", "head-base", "eyes", "mouth", "hair"] }, "minimumVariants": { "type": "integer", "minimum": 1 }, "requiredExpressions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "paletteChannels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "runtimeMountPoint": { "type": "string", "pattern": "^combat\\.actor\\.[a-z-]+$" } } },
    "composition": { "type": "object", "additionalProperties": false, "required": ["body", "head-base", "eyes", "mouth", "hair"], "properties": { "body": { "const": "required" }, "head-base": { "const": "required" }, "eyes": { "const": "required" }, "mouth": { "const": "required" }, "hair": { "const": "required" } } },
    "clipAcceptance": { "type": "object", "additionalProperties": false, "required": ["move", "sharedFrameTimeline", "allPartsShareAnchors", "allFramesSameOriginPivot", "manualSignature"], "properties": { "move": { "type": "string", "minLength": 1 }, "sharedFrameTimeline": { "const": true }, "allPartsShareAnchors": { "const": true }, "allFramesSameOriginPivot": { "const": true }, "manualSignature": { "const": "required" } } },
    "runtimeBinding": { "type": "object", "additionalProperties": false, "required": ["logicalIdOnly", "fallback", "fallbackScope"], "properties": { "logicalIdOnly": { "const": true }, "fallback": { "const": "existing_runtime_css_debug_only" }, "fallbackScope": { "const": "development-only" } } },
    "actor": { "type": "object", "additionalProperties": false, "required": ["id", "logicalAssetId", "requiredSlotId", "runtimeMountPoint", "role", "status", "referenceCandidates", "defaultComposition", "requiredClips", "clipAcceptance", "runtimeBinding"], "properties": { "id": { "enum": ["player", "enemy"] }, "logicalAssetId": { "type": "string", "minLength": 1 }, "requiredSlotId": { "const": "combat-side-view-character-sprites" }, "runtimeMountPoint": { "const": "combat.actor" }, "role": { "enum": ["player", "enemy"] }, "status": { "const": "missing" }, "referenceCandidates": { "type": "array", "maxItems": 0, "items": { "type": "string" } }, "defaultComposition": { "$ref": "#/$defs/composition" }, "requiredClips": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string" } }, "clipAcceptance": { "$ref": "#/$defs/clipAcceptance" }, "runtimeBinding": { "$ref": "#/$defs/runtimeBinding" } } },
    "acceptanceGate": { "type": "object", "additionalProperties": false, "required": ["productionStatus", "requiredEvidence", "nextAction"], "properties": { "productionStatus": { "const": "blocked" }, "requiredEvidence": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "type": "string" } }, "nextAction": { "type": "string", "minLength": 1 } } }
  }
}
