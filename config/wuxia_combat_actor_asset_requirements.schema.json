{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/wuxia_combat_actor_asset_requirements.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractId", "version", "taskId", "mode", "shippingAllowed", "sourcePolicy", "policy", "referenceAudit", "actors", "acceptanceGate"],
  "properties": {
    "$schema": { "const": "idlewuxia.combat_actor_asset_requirements.v1" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "const": 1 },
    "taskId": { "const": "ASSET-007" },
    "mode": { "const": "requirements-only" },
    "shippingAllowed": { "const": false },
    "sourcePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceMayInformRequirements", "referenceBytesMayShip", "referenceBindingsMaySatisfyProduction", "runtimeUsesLogicalIdsOnly"],
      "properties": {
        "referenceMayInformRequirements": { "const": true },
        "referenceBytesMayShip": { "const": false },
        "referenceBindingsMaySatisfyProduction": { "const": false },
        "runtimeUsesLogicalIdsOnly": { "const": true }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["view", "headCountRange", "requiredClips", "walkFootPhasePolicy", "noBakedScenePixels", "integerScaleOnly", "transparentBackgroundRequired", "manualFrameReviewRequired", "portraitSafeAreaRequired"],
      "properties": {
        "view": { "const": "side" },
        "headCountRange": { "$ref": "#/$defs/range" },
        "requiredClips": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
        "walkFootPhasePolicy": { "const": "alternate-left-right" },
        "noBakedScenePixels": { "const": true },
        "integerScaleOnly": { "const": true },
        "transparentBackgroundRequired": { "const": true },
        "manualFrameReviewRequired": { "const": true },
        "portraitSafeAreaRequired": { "const": true }
      }
    },
    "referenceAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceRootId", "referenceRoot", "inventory", "eligibleCandidates", "ineligibleEvidence", "conclusion", "auditedAt", "auditor"],
      "properties": {
        "referenceRootId": { "type": "string", "minLength": 1 },
        "referenceRoot": { "type": "string", "minLength": 1 },
        "inventory": { "type": "object", "additionalProperties": false, "required": ["png", "jpg", "mp3", "lua", "txt", "totalFiles", "inventoryBasis"], "properties": { "png": { "type": "integer", "minimum": 0 }, "jpg": { "type": "integer", "minimum": 0 }, "mp3": { "type": "integer", "minimum": 0 }, "lua": { "type": "integer", "minimum": 0 }, "txt": { "type": "integer", "minimum": 0 }, "totalFiles": { "type": "integer", "minimum": 1 }, "inventoryBasis": { "type": "string", "minLength": 1 } } },
        "eligibleCandidates": { "type": "array", "maxItems": 0, "items": { "type": "object" } },
        "ineligibleEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "conclusion": { "type": "string", "minLength": 1 },
        "auditedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "auditor": { "type": "string", "minLength": 1 }
      }
    },
    "actors": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/actor" } },
    "acceptanceGate": { "$ref": "#/$defs/acceptanceGate" }
  },
  "$defs": {
    "range": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "number", "exclusiveMinimum": 0 }, "max": { "type": "number", "exclusiveMinimum": 0 } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["relativePath", "kind", "observed", "disposition", "reason"], "properties": { "relativePath": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }, "observed": { "type": "string", "minLength": 1 }, "disposition": { "const": "ineligible" }, "reason": { "type": "string", "minLength": 1 } } },
    "actor": { "type": "object", "additionalProperties": false, "required": ["id", "logicalAssetId", "requiredSlotId", "runtimeMountPoint", "role", "status", "referenceCandidates", "requiredClips", "clipAcceptance", "runtimeBinding"], "properties": { "id": { "enum": ["player", "enemy"] }, "logicalAssetId": { "type": "string", "minLength": 1 }, "requiredSlotId": { "const": "combat-side-view-character-sprites" }, "runtimeMountPoint": { "const": "combat.actor" }, "role": { "enum": ["player", "enemy"] }, "status": { "const": "missing" }, "referenceCandidates": { "type": "array", "maxItems": 0, "items": { "type": "string" } }, "requiredClips": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } }, "clipAcceptance": { "type": "object", "additionalProperties": false, "required": ["walk_left", "walk_right", "alternatingWalkFrames", "allFramesSamePivot", "manualSignature"], "properties": { "walk_left": { "type": "string", "minLength": 1 }, "walk_right": { "type": "string", "minLength": 1 }, "alternatingWalkFrames": { "const": true }, "allFramesSamePivot": { "const": true }, "manualSignature": { "const": "required" } } }, "runtimeBinding": { "type": "object", "additionalProperties": false, "required": ["logicalIdOnly", "fallback", "fallbackScope"], "properties": { "logicalIdOnly": { "const": true }, "fallback": { "const": "existing_runtime_css_debug_only" }, "fallbackScope": { "const": "development-only" } } } } },
    "acceptanceGate": { "type": "object", "additionalProperties": false, "required": ["productionStatus", "requiredEvidence", "nextAction"], "properties": { "productionStatus": { "const": "blocked" }, "requiredEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "nextAction": { "type": "string", "minLength": 1 } } }
  }
}
