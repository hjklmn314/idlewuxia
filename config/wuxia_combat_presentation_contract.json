  "requirements": [
    {
      "taskId": "ASSET-007",
      "slotId": "combat-side-view-character-sprites",
      "purpose": "Side-view legless modular head/body player and enemy combat actors.",
      "mustProvide": ["body", "head-base", "eyes", "mouth", "hair", "idle", "move", "attack", "hurt", "control", "defeat", "shared anchors", "shared frame timeline", "pivot", "sha256", "ownership"],
      "acceptance": ["Only side view", "No independent leg silhouette", "Every required part independently replaceable", "96x96 shared canvas", "Body compress/translate/recover movement", "No baked scene pixels", "Manual frame-by-frame and composition signature"]
    },
    {
      "taskId": "ASSET-008",
      "slotId": "combat-clean-background-scenes",
      "purpose": "Clean portrait combat scenes with actors mounted at runtime.",
      "mustProvide": ["transparent-or-clean scene", "safe actor landing zones", "three viewport crops", "sha256", "ownership"],
      "acceptance": ["No baked characters", "No UI baked into scene", "Readable behind combat HUD", "Manual three-size review"]
    },
    {
      "taskId": "ASSET-009",
      "slotId": "combat-vfx-atlas-family",
      "purpose": "Hit, block, miss, control, buff, defeat and victory feedback.",
      "mustProvide": ["28 cue IDs", "16 buff icon IDs", "integer-scale pixel frames", "budget", "sha256", "ownership"],
      "acceptance": ["Every configured cue resolves", "Actor-bound and target-bound", "No occlusion of combat information", "No CSS-only production fallback"]
    },
    {
      "taskId": "ASSET-010",
      "slotId": "combat-sfx-and-music-family",
      "purpose": "Combat impact, heal, buff, control, defeat and victory audio.",
      "mustProvide": ["5 logical cue IDs", "OGG files", "loudness metadata", "latency budget", "sha256", "ownership"],
      "acceptance": ["No oscillator in production", "No missing cue", "Device latency <=120ms", "Manual mix and replay review"]
    }
  ]
