{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/wuxia_combat_reference_asset_overlay.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "overlayId", "version", "mode", "shippingAllowed", "sourcePolicy", "sourceProject", "activation", "bindingCoverage", "assets", "bindings", "developmentFallbacks"],
  "properties": {
    "$schema": { "const": "idlewuxia.combat_reference_asset_overlay.v1" },
    "overlayId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "mode": { "const": "development-only" },
    "shippingAllowed": { "const": false },
    "sourcePolicy": { "const": "reference-only" },
    "sourceProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "root", "usage", "approval", "licenseStatus", "shippingAllowed", "referenceBytesMayShip"],
      "properties": {
        "projectId": { "const": "fangzhijianghu-original-project" },
        "root": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$" },
        "usage": { "const": "original-project-development-binding" },
        "approval": { "const": "user-approved-development-only" },
        "licenseStatus": { "const": "not-shipping-verified" },
        "shippingAllowed": { "const": false },
        "referenceBytesMayShip": { "const": false }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryQueryParameter", "legacyQueryParameter", "localhostOnly", "defaultEnabled"],
      "properties": {
        "primaryQueryParameter": { "const": "originalProjectAssets" },
        "legacyQueryParameter": { "const": "referenceAssets" },
        "localhostOnly": { "const": true },
        "defaultEnabled": { "const": false }
      }
    },
    "bindingCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "scene", "vfx", "buff", "audio"],
      "properties": {
        "actor": { "$ref": "#/$defs/missingCoverage" },
        "scene": { "$ref": "#/$defs/boundCoverage" },
        "vfx": { "$ref": "#/$defs/missingCoverage" },
        "buff": { "$ref": "#/$defs/boundCoverage" },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "bindingGroup", "logicalCount", "uniqueSourceCount", "inputFormat", "requiredProductionFormat", "requiresOwnedReplacement"],
          "properties": {
            "status": { "const": "bound-development-only" },
            "bindingGroup": { "const": "audio" },
            "logicalCount": { "const": 5 },
            "uniqueSourceCount": { "const": 4 },
            "inputFormat": { "const": "mp3" },
            "requiredProductionFormat": { "const": "ogg" },
            "requiresOwnedReplacement": { "const": true }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "format", "path", "adoption", "approval", "mountPoint"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["scene", "audio", "buff-icon"] },
          "format": { "enum": ["png", "webp", "jpg", "mp3"] },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$" },
          "adoption": { "const": "reference-only" },
          "approval": { "const": "development-only" },
          "mountPoint": { "enum": ["combat.scene", "combat.audio", "combat.vfx"] }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenes", "audio", "buffIcons"],
      "properties": {
        "scenes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/assetId" } },
        "audio": { "type": "object", "additionalProperties": { "$ref": "#/$defs/assetId" } },
        "buffIcons": { "type": "object", "additionalProperties": { "$ref": "#/$defs/assetId" } }
      }
    },
    "developmentFallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "vfx", "audio"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "vfx": { "type": "string", "minLength": 1 },
        "audio": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "assetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "missingCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolution", "reason"],
      "properties": {
        "status": { "const": "missing" },
        "resolution": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "boundCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "bindingGroup", "logicalCount", "uniqueSourceCount"],
      "properties": {
        "status": { "const": "bound-development-only" },
        "bindingGroup": { "enum": ["scenes", "buffIcons"] },
        "logicalCount": { "type": "integer", "minimum": 1 },
        "uniqueSourceCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
