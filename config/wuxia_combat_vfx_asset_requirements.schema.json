{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/wuxia_combat_vfx_asset_requirements.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractId", "version", "taskId", "mode", "shippingAllowed", "sourcePolicy", "policy", "referenceAudit", "visualCues", "buffIcons", "acceptanceGate"],
  "properties": {
    "$schema": { "const": "idlewuxia.combat_vfx_asset_requirements.v1" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "const": 1 },
    "taskId": { "const": "ASSET-009" },
    "mode": { "const": "reference-backed-requirements" },
    "shippingAllowed": { "const": false },
    "sourcePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceMayInformRequirements", "referenceBytesMayShip", "referenceBindingsMaySatisfyProduction", "runtimeUsesLogicalIdsOnly"],
      "properties": {
        "referenceMayInformRequirements": { "const": true },
        "referenceBytesMayShip": { "const": false },
        "referenceBindingsMaySatisfyProduction": { "const": false },
        "runtimeUsesLogicalIdsOnly": { "const": true }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["visualCueCount", "buffIconCount", "integerScaleOnly", "actorOrTargetBound", "noProductionCssFallback", "manualFrameReviewRequired", "noOcclusionOfCombatInfo", "ownedOrLicensedRequired", "portraitViewportCrops", "requiredCuePhases", "requiredFeedbackFamilies", "runtimeBindingPolicy"],
      "properties": {
        "visualCueCount": { "const": 28 },
        "buffIconCount": { "const": 16 },
        "integerScaleOnly": { "const": true },
        "actorOrTargetBound": { "const": true },
        "noProductionCssFallback": { "const": true },
        "manualFrameReviewRequired": { "const": true },
        "noOcclusionOfCombatInfo": { "const": true },
        "ownedOrLicensedRequired": { "const": true },
        "portraitViewportCrops": { "const": ["portrait-360x800", "portrait-390x844", "portrait-540x960"] },
        "requiredCuePhases": { "const": ["anticipation", "impact", "settle"] },
        "requiredFeedbackFamilies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "runtimeBindingPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["logicalIdOnly", "mountPoint", "cueFallback", "buffFallback", "fallbackScope"],
          "properties": {
            "logicalIdOnly": { "const": true },
            "mountPoint": { "const": "combat.vfx" },
            "cueFallback": { "const": "existing_runtime_css_feedback_only" },
            "buffFallback": { "const": "text-label" },
            "fallbackScope": { "const": "development-only" }
          }
        }
      }
    },
    "referenceAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceRootId", "referenceRoot", "inventory", "eligibleVfxCandidates", "eligibleBuffCandidates", "ineligibleEvidence", "conclusion", "auditedAt", "auditor"],
      "properties": {
        "referenceRootId": { "type": "string", "minLength": 1 },
        "referenceRoot": { "type": "string", "minLength": 1 },
        "inventory": {
          "type": "object", "additionalProperties": false,
          "required": ["fightEffectRasterCandidates", "skillUiPngCandidates", "buffIconPngCandidates", "auditedBuffIconCandidates", "inventoryBasis"],
          "properties": {
            "fightEffectRasterCandidates": { "const": 0 },
            "skillUiPngCandidates": { "const": 47 },
            "buffIconPngCandidates": { "const": 170 },
            "auditedBuffIconCandidates": { "const": 6 },
            "inventoryBasis": { "type": "string", "minLength": 1 }
          }
        },
        "eligibleVfxCandidates": { "type": "array", "maxItems": 0, "items": { "type": "object" } },
        "eligibleBuffCandidates": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/referenceCandidate" } },
        "ineligibleEvidence": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/evidence" } },
        "conclusion": { "type": "string", "minLength": 1 },
        "auditedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "auditor": { "type": "string", "minLength": 1 }
      }
    },
    "visualCues": { "type": "array", "minItems": 28, "maxItems": 28, "items": { "$ref": "#/$defs/visualCue" } },
    "buffIcons": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/buffIcon" } },
    "acceptanceGate": { "$ref": "#/$defs/gate" }
  },
  "$defs": {
    "referenceCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceAssetId", "relativePath", "kind", "dimensions", "bytes", "sha256", "manualObservation", "disposition"],
      "properties": {
        "referenceAssetId": { "type": "string", "pattern": "^ref-[a-z0-9-]+$" },
        "relativePath": { "type": "string", "minLength": 1 },
        "kind": { "const": "buff-icon" },
        "dimensions": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": { "width": { "const": 52 }, "height": { "const": 54 } }
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manualObservation": { "type": "string", "minLength": 1 },
        "disposition": { "const": "reference-only" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "kind", "observed", "disposition", "reason"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "observed": { "type": "string", "minLength": 1 },
        "disposition": { "const": "ineligible" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["logicalIdOnly", "fallback", "fallbackScope"],
      "properties": {
        "logicalIdOnly": { "const": true },
        "fallback": { "type": "string", "minLength": 1 },
        "fallbackScope": { "const": "development-only" }
      }
    },
    "visualCue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "logicalAssetId", "eventType", "requiredPresentation", "status", "referenceAssetId"],
      "properties": {
        "id": { "type": "string", "pattern": "^cue_[a-z0-9_]+$" },
        "logicalAssetId": { "type": "string", "pattern": "^combat-vfx-cue-[a-z0-9-]+$" },
        "eventType": { "type": "string", "minLength": 1 },
        "requiredPresentation": { "type": "string", "minLength": 1 },
        "status": { "const": "missing" },
        "referenceAssetId": { "const": null }
      }
    },
    "buffIcon": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "logicalAssetId", "status", "referenceAssetId", "semanticRole"],
      "properties": {
        "id": { "type": "string", "pattern": "^buff_[a-z0-9_]+$" },
        "logicalAssetId": { "type": "string", "pattern": "^combat-buff-[a-z0-9-]+$" },
        "status": { "const": "reference-only" },
        "referenceAssetId": { "type": "string", "pattern": "^ref-buff-[a-z0-9-]+$" },
        "semanticRole": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["productionStatus", "requiredEvidence", "nextAction"],
      "properties": {
        "productionStatus": { "const": "blocked" },
        "requiredEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "nextAction": { "type": "string", "minLength": 1 }
      }
    }
  }
}
