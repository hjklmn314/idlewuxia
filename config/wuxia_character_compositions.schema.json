{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/wuxia_character_compositions.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registryId", "version", "status", "shippingAllowed", "policy", "requiredParts", "optionalParts", "layerOrderBackToFront", "parts", "compositions"],
  "properties": {
    "$schema": { "const": "idlewuxia.character_compositions.v1" },
    "registryId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "const": 1 },
    "status": { "enum": ["requirements-ready-assets-missing", "development-ready", "production-ready"] },
    "shippingAllowed": { "type": "boolean" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construction", "view", "canonicalFacing", "opposingSideTransform", "logicalCanvasPx", "legSilhouette", "movementPhasePolicy", "missingPartPolicy"],
      "properties": {
        "construction": { "const": "modular-head-body" },
        "view": { "const": "side" },
        "canonicalFacing": { "const": "right" },
        "opposingSideTransform": { "const": "horizontal-mirror" },
        "logicalCanvasPx": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 96 }, "height": { "const": 96 } } },
        "legSilhouette": { "const": "forbidden" },
        "movementPhasePolicy": { "const": "body-compress-translate-recover" },
        "missingPartPolicy": { "const": "fail-closed" }
      }
    },
    "requiredParts": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["body", "head-base", "eyes", "mouth", "hair"] } },
    "optionalParts": { "type": "array", "uniqueItems": true, "items": { "enum": ["headwear", "face-accessory", "weapon-rear", "weapon-front", "contact-shadow"] } },
    "layerOrderBackToFront": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "enum": ["body", "head-base", "eyes", "mouth", "hair", "headwear", "face-accessory", "weapon-rear", "weapon-front", "contact-shadow"] } },
    "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
    "compositions": { "type": "array", "items": { "$ref": "#/$defs/composition" } }
  },
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": 0, "maximum": 95 }, "y": { "type": "integer", "minimum": 0, "maximum": 95 } } },
    "clip": { "type": "object", "additionalProperties": false, "required": ["frameCount", "fps", "frames", "bodyPhases"], "properties": { "frameCount": { "type": "integer", "minimum": 1 }, "fps": { "type": "number", "exclusiveMinimum": 0 }, "frames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "bodyPhases": { "type": "array", "minItems": 1, "items": { "enum": ["neutral", "compress", "translate", "recover"] } } } },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partType", "assetId", "view", "canonicalFacing", "legSilhouette", "canvas", "pivot", "anchors", "clips"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "partType": { "enum": ["body", "head-base", "eyes", "mouth", "hair", "headwear", "face-accessory", "weapon-rear", "weapon-front", "contact-shadow"] },
        "assetId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "view": { "const": "side" },
        "canonicalFacing": { "const": "right" },
        "legSilhouette": { "const": "forbidden" },
        "canvas": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 96 }, "height": { "const": 96 } } },
        "pivot": { "$ref": "#/$defs/point" },
        "anchors": { "type": "object", "required": ["origin", "head", "face", "weapon-main", "fx-center", "ground-contact"], "properties": { "origin": { "$ref": "#/$defs/point" }, "head": { "$ref": "#/$defs/point" }, "face": { "$ref": "#/$defs/point" }, "weapon-main": { "$ref": "#/$defs/point" }, "fx-center": { "$ref": "#/$defs/point" }, "ground-contact": { "$ref": "#/$defs/point" } }, "additionalProperties": { "$ref": "#/$defs/point" } },
        "clips": { "type": "object", "required": ["idle", "move", "attack", "hurt", "control", "defeat"], "properties": { "idle": { "$ref": "#/$defs/clip" }, "move": { "$ref": "#/$defs/clip" }, "attack": { "$ref": "#/$defs/clip" }, "hurt": { "$ref": "#/$defs/clip" }, "control": { "$ref": "#/$defs/clip" }, "defeat": { "$ref": "#/$defs/clip" } }, "additionalProperties": { "$ref": "#/$defs/clip" } }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parts", "palette"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "parts": { "type": "object", "required": ["body", "head-base", "eyes", "mouth", "hair"], "properties": { "body": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "head-base": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "eyes": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "mouth": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "hair": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "headwear": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "face-accessory": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "weapon-rear": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "weapon-front": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "contact-shadow": { "type": "string", "pattern": "^[a-z0-9-]+$" } }, "additionalProperties": false },
        "palette": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" } } }
      }
    }
  }
}
