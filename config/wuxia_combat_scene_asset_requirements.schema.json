{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idlewuxia.local/schema/wuxia_combat_scene_asset_requirements.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "contractId", "version", "taskId", "mode", "shippingAllowed", "sourcePolicy", "policy", "referenceAudit", "scenes", "acceptanceGate"],
  "properties": {
    "$schema": { "const": "idlewuxia.combat_scene_asset_requirements.v1" }, "contractId": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "version": { "const": 1 }, "taskId": { "const": "ASSET-008" }, "mode": { "const": "reference-backed-requirements" }, "shippingAllowed": { "const": false },
    "sourcePolicy": { "type": "object", "additionalProperties": false, "required": ["referenceMayInformDevelopment", "referenceBytesMayShip", "referenceBindingsMaySatisfyProduction", "runtimeUsesLogicalIdsOnly"], "properties": { "referenceMayInformDevelopment": { "const": true }, "referenceBytesMayShip": { "const": false }, "referenceBindingsMaySatisfyProduction": { "const": false }, "runtimeUsesLogicalIdsOnly": { "const": true } } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["portraitOnly", "noBakedCharacters", "noBakedUi", "actorMountedAtRuntime", "safeActorLandingZonesRequired", "threeViewportCropsRequired", "manualVisualReviewRequired", "integerScalePixelTreatment"], "properties": { "portraitOnly": { "const": true }, "noBakedCharacters": { "const": true }, "noBakedUi": { "const": true }, "actorMountedAtRuntime": { "const": true }, "safeActorLandingZonesRequired": { "const": true }, "threeViewportCropsRequired": { "const": true }, "manualVisualReviewRequired": { "const": true }, "integerScalePixelTreatment": { "const": true } } },
    "referenceAudit": { "type": "object", "additionalProperties": false, "required": ["referenceRootId", "referenceRoot", "candidateCount", "candidates", "visualLimitation", "auditedAt", "auditor"], "properties": { "referenceRootId": { "type": "string", "minLength": 1 }, "referenceRoot": { "type": "string", "minLength": 1 }, "candidateCount": { "const": 2 }, "candidates": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/candidate" } }, "visualLimitation": { "type": "string", "minLength": 1 }, "auditedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "auditor": { "type": "string", "minLength": 1 } } },
    "scenes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/scene" } },
    "acceptanceGate": { "$ref": "#/$defs/gate" }
  },
  "$defs": {
    "candidate": { "type": "object", "additionalProperties": false, "required": ["referenceAssetId", "relativePath", "dimensions", "bytes", "sha256", "containsBakedCharacters", "containsBakedUi", "manualObservation", "disposition"], "properties": { "referenceAssetId": { "type": "string", "minLength": 1 }, "relativePath": { "type": "string", "minLength": 1 }, "dimensions": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "containsBakedCharacters": { "const": false }, "containsBakedUi": { "const": false }, "manualObservation": { "type": "string", "minLength": 1 }, "disposition": { "const": "reference-only" } } },
    "scene": { "type": "object", "additionalProperties": false, "required": ["id", "logicalAssetId", "requiredSlotId", "runtimeMountPoint", "status", "referenceAssetId", "runtimeBinding", "safeActorLandingZones", "viewportCrops"], "properties": { "id": { "type": "string", "minLength": 1 }, "logicalAssetId": { "type": "string", "minLength": 1 }, "requiredSlotId": { "const": "combat-clean-background-scenes" }, "runtimeMountPoint": { "const": "combat.scene" }, "status": { "const": "reference-only" }, "referenceAssetId": { "type": "string", "minLength": 1 }, "runtimeBinding": { "type": "object", "additionalProperties": false, "required": ["logicalIdOnly", "fallback", "fallbackScope"], "properties": { "logicalIdOnly": { "const": true }, "fallback": { "const": "css_courtyard" }, "fallbackScope": { "const": "development-only" } } }, "safeActorLandingZones": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["id", "x", "baselineY", "maxWidth", "maxHeight"], "properties": { "id": { "enum": ["player", "enemy"] }, "x": { "type": "number", "minimum": 0, "maximum": 1 }, "baselineY": { "type": "number", "minimum": 0, "maximum": 1 }, "maxWidth": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "maxHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } } }, "viewportCrops": { "type": "array", "const": ["portrait-360x800", "portrait-390x844", "portrait-540x960"] } } },
    "gate": { "type": "object", "additionalProperties": false, "required": ["productionStatus", "requiredEvidence", "nextAction"], "properties": { "productionStatus": { "const": "blocked" }, "requiredEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "nextAction": { "type": "string", "minLength": 1 } } }
  }
}
